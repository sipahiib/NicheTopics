{
  "name": "video-graphic-design-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio --no-open",
    "lint": "eslint src && tsc --noEmit",
    "voiceover": "node scripts/generate-voiceover.mjs",
    "render": "remotion render Graphic-Design-AI output/graphic-design-ai-master.mp4",
